---
import { Image } from 'astro:assets';
import fullFaceResult from '../assets/ba.webp';
import lipResult from '../assets/ba2.webp';

const results = [
  {
    image: fullFaceResult,
    title: 'Resultado facial',
    alt: 'Antes e depois de resultado facial realizado pela Dra. Dienifer Hanich',
  },
  {
    image: lipResult,
    title: 'Resultado labial',
    alt: 'Antes e depois de resultado labial realizado pela Dra. Dienifer Hanich',
  },
];
---

<div class="results-grid" aria-label="Resultados antes e depois">
  {
    results.map((result) => (
      <figure class="result-card">
        <div class="result-card__media">
          <Image
            class="result-card__image"
            src={result.image}
            alt={result.alt}
            width={992}
            height={1077}
            loading="lazy"
            format="avif"
            sizes="(min-width: 1100px) 38vw, (min-width: 720px) 46vw, 100vw"
          />
          <span class="result-card__label result-card__label--before">ANTES</span>
          <span class="result-card__label result-card__label--after">DEPOIS</span>
        </div>
        <figcaption>
          <span>{result.title}</span>
          <small>Resultado individual</small>
        </figcaption>
      </figure>
    ))
  }
</div>

<p class="mt-6 max-w-2xl text-xs leading-6 text-[color:var(--muted-dark)]">
  Resultados reais podem variar conforme características individuais, avaliação profissional e plano de tratamento.
</p>
