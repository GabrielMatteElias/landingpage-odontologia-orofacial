---
import { Image } from "astro:assets";
import Header from "../components/Header.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Footer from "../components/Footer.astro";
import heroPortrait from "../assets/hero.webp";
import profileImg from "../assets/profile.webp";
import whatsImg from "../assets/whatsapp.webp";
import { site, whatsappUrl, treatments, faqs, posts } from "../data";
import "../styles/global.css";
import Location from "../components/Location.astro";

const schema = {
    "@context": "https://schema.org",
    "@type": "HealthAndBeautyBusiness",
    name: site.professional,
    description: site.seoDescription,
    telephone: `+${site.whatsapp}`,
    sameAs: [site.instagram],
};
---

<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{site.seoTitle}</title>
        <meta name="description" content={site.seoDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={site.seoTitle} />
        <meta property="og:description" content={site.seoDescription} />
        <meta property="og:locale" content="pt_BR" />
        <meta
            property="og:image"
            content="https://landingpage-odontologia-orofacial.vercel.app/og_image.webp"
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/webp" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="icon" href="/logo.webp" />
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </head>

    <body>
        <Header />
        <main>
            <section id="inicio" class="hero-shell pt-[72px]">
                <div
                    class="container grid min-h-[calc(100svh-72px)] items-center gap-10 py-10 md:grid-cols-[.9fr_1.1fr] md:gap-16 md:py-14"
                >
                    <div class="reveal order-2 md:order-1">
                        <p class="eyebrow text-[color:var(--gold)]">
                            {site.specialty}
                        </p>
                        <h1
                            class="serif mt-5 max-w-[640px] text-[clamp(3.25rem,8vw,7.4rem)] leading-[.9]"
                        >
                            {site.brand}
                        </h1>
                        <p
                            class="mt-6 max-w-[520px] text-[clamp(1.15rem,2vw,1.55rem)] leading-8 text-[color:var(--champagne)]"
                        >
                            {site.positioning}
                        </p>
                        <p
                            class="mt-6 max-w-[440px] leading-7 text-[color:var(--muted-dark)]"
                        >
                            Uma experiência de estética facial construída com
                            análise, naturalidade e cuidado para cada decisão
                            fazer sentido no seu rosto.
                        </p>
                        <div class="mt-9 flex flex-wrap gap-3">
                            <a
                                class="btn btn-gold"
                                href={whatsappUrl}
                                target="_blank"
                                rel="noreferrer"
                                >Agendar atendimento <span aria-hidden="true"
                                    >↗</span
                                ></a
                            >
                            <a
                                class="btn btn-ghost"
                                href={site.instagram}
                                target="_blank"
                                rel="noreferrer"
                                >Ver Instagram <span aria-hidden="true">↗</span
                                ></a
                            >
                        </div>
                    </div>

                    <div class="hero-card reveal relative order-1 md:order-2">
                        <Image
                            class="photo"
                            src={heroPortrait}
                            alt={`${site.professional} em retrato profissional`}
                            width={1024}
                            height={1024}
                            loading="eager"
                            fetchpriority="high"
                            format="avif"
                        />
                        <div class="hero-card__label">
                            <span>{site.initials}</span>
                            <small>{site.specialty}</small>
                        </div>
                    </div>
                </div>
            </section>

            <div class="marquee">
                <div class="marquee__track">
                    <span>
                        Botox · naturalidade · análise facial · propósito ·
                        bem-estar · resultados naturais ·
                    </span>
                    <span aria-hidden="true">
                        Botox · naturalidade · análise facial · propósito ·
                        bem-estar · resultados naturais ·
                    </span>
                    <span aria-hidden="true">
                        Botox · naturalidade · análise facial · propósito ·
                        bem-estar · resultados naturais ·
                    </span>
                    <span aria-hidden="true">
                        Botox · naturalidade · análise facial · propósito ·
                        bem-estar · resultados naturais ·
                    </span>
                </div>
            </div>

            <section
                id="filosofia"
                class="section-pad bg-[color:var(--plum)] text-[color:var(--ivory)]"
            >
                <div
                    class="container grid gap-12 md:grid-cols-[.7fr_1.3fr] md:gap-20"
                >
                    <div>
                        <p class="eyebrow text-[color:var(--gold)]">
                            Filosofia
                        </p>
                        <p
                            class="mt-7 text-sm leading-7 text-[color:var(--muted-dark)]"
                        >
                            A estética mais sofisticada é aquela que melhora a
                            presença sem apagar a identidade.
                        </p>
                    </div>
                    <div>
                        <h2
                            class="serif max-w-3xl text-[clamp(2.6rem,6vw,5.8rem)] leading-[.96]"
                        >
                            Realçar a sua melhor versão, sem exageros.
                        </h2>
                        <p
                            class="mt-9 max-w-2xl text-lg leading-8 text-[color:var(--muted-dark)]"
                        >
                            As referências da marca apontam para um cuidado
                            premium, feminino e objetivo: resultados naturais,
                            planejamento antes do procedimento e uma comunicação
                            clara sobre o que pode ser alcançado.
                        </p>
                    </div>
                </div>
            </section>

            <section
                id="tratamentos"
                class="section-pad bg-[color:var(--ivory)]"
            >
                <div
                    class="container grid gap-12 md:grid-cols-[.65fr_1.35fr] md:gap-24"
                >
                    <div>
                        <p class="eyebrow">Atendimentos</p>
                        <h2
                            class="serif mt-5 text-5xl leading-none md:text-7xl"
                        >
                            Recursos com indicação.
                        </h2>
                        <p
                            class="mt-7 max-w-sm leading-7 text-[color:var(--muted)]"
                        >
                            O procedimento não vem antes da análise. Cada
                            escolha precisa respeitar proporções, expressão e
                            objetivos.
                        </p>
                    </div>
                    <div>
                        {
                            treatments.map((item) => (
                                <div class="treatment-row">
                                    <>
                                        <span class="eyebrow">
                                            {item.number}
                                        </span>
                                        <h3>{item.title}</h3>
                                        <p>{item.text}</p>
                                    </>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section
                id="resultados"
                class="section-pad bg-[color:var(--obsidian)] text-[color:var(--ivory)]"
            >
                <div class="container">
                    <div class="max-w-3xl">
                        <p class="eyebrow text-[color:var(--gold)]">
                            Antes e depois
                        </p>
                        <h2
                            class="serif mt-5 text-5xl leading-none md:text-7xl"
                        >
                            Resultados naturais falam por si.
                        </h2>
                        <p
                            class="mt-7 max-w-2xl leading-7 text-[color:var(--muted-dark)]"
                        >
                            Uma seleção objetiva de registros clínicos para
                            observar evolução, proporção e naturalidade com mais
                            clareza.
                        </p>
                    </div>
                    <div class="mt-12">
                        <BeforeAfter />
                    </div>
                </div>
            </section>

            <section id="sobre" class="section-pad bg-[color:var(--ivory)]">
                <div
                    class="container grid items-center gap-12 md:grid-cols-[.95fr_1.05fr] md:gap-24"
                >
                    <div class="reveal portrait-panel">
                        <Image
                            class="photo"
                            src={profileImg}
                            alt={`Retrato da ${site.professional}`}
                            width={900}
                            height={900}
                            loading="lazy"
                            format="avif"
                        />
                    </div>
                    <div class="reveal">
                        <p class="eyebrow">Sobre a profissional</p>
                        <h2
                            class="serif mt-5 text-5xl leading-none md:text-7xl"
                        >
                            Estética com propósito.
                        </h2>
                        <p
                            class="mt-8 text-lg leading-8 text-[color:var(--muted)]"
                        >
                            A Dra. Dienifer Hanich assina uma estética orientada por
                            bem-estar, naturalidade e intenção. O foco do
                            atendimento é entender o que cada rosto pede antes
                            de indicar qualquer procedimento.
                        </p>
                        <p class="mt-5 leading-7 text-[color:var(--muted)]">
                            O material de marca destaca uma atuação ligada a
                            resultados naturais e cuidado personalizado, com
                            presença também como apoiadora do Miss Universe
                            Trans Brasil.
                        </p>
                        <div
                            class="mt-9 grid grid-cols-1 gap-3 border-t border-[color:var(--line)] pt-6 text-sm text-[color:var(--plum)] sm:grid-cols-2"
                        >
                            <span>Planejamento facial</span>
                            <span>Resultados naturais</span>
                            <span>Escuta e orientação</span>
                            <span>Bem-estar com propósito</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="section-pad bg-[color:var(--blush)]">
                <div class="container">
                    <p class="eyebrow">Experiência</p>
                    <div class="mt-12 grid gap-8 md:grid-cols-4">
                        {
                            [
                                [
                                    "01",
                                    "Conversar",
                                    "Entender objetivos, dúvidas e expectativas.",
                                ],
                                [
                                    "02",
                                    "Analisar",
                                    "Observar expressão, contorno, sustentação e pele.",
                                ],
                                [
                                    "03",
                                    "Planejar",
                                    "Indicar apenas o que faz sentido para o caso.",
                                ],
                                [
                                    "04",
                                    "Acompanhar",
                                    "Orientar evolução, cuidados e próximos passos.",
                                ],
                            ].map(([number, title, text]) => (
                                <div class="experience-item">
                                    <span>{number}</span>
                                    <h3>{title}</h3>
                                    <p>{text}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section
                class="section-pad bg-[color:var(--plum)] text-[color:var(--ivory)]"
            >
                <div class="container">
                    <div class="grid items-end gap-10 md:grid-cols-[1fr_auto]">
                        <div>
                            <p class="eyebrow text-[color:var(--gold)]">
                                Conteúdo e bastidores
                            </p>
                            <h2
                                class="serif mt-5 text-5xl leading-none md:text-7xl"
                            >
                                Acompanhe o trabalho da Dienifer.
                            </h2>
                            <p
                                class="mt-6 max-w-md leading-7 text-[color:var(--muted-dark)]"
                            >
                                Veja resultados, bastidores e conteúdos
                                publicados no perfil oficial.
                            </p>
                        </div>
                        <a
                            class="btn btn-gold"
                            href={site.instagram}
                            target="_blank"
                            rel="noreferrer">Conhecer o Instagram ↗</a
                        >
                    </div>
                    <div
                        class="post-gallery mt-14"
                        aria-label={`Galeria de posts da ${site.professional}`}
                    >
                        {
                            posts.map(({ image, alt }) => (
                                <figure class="post-frame">
                                    <div class="post-frame__media">
                                        <Image
                                            src={image}
                                            width={500}
                                            alt={alt}
                                        />
                                    </div>
                                </figure>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section id="faq" class="section-pad bg-[color:var(--ivory)]">
                <div
                    class="container grid gap-12 md:grid-cols-[.7fr_1.3fr] md:gap-24"
                >
                    <div>
                        <p class="eyebrow">Perguntas frequentes</p>
                        <h2
                            class="serif mt-5 text-5xl leading-none md:text-7xl"
                        >
                            Antes de começar.
                        </h2>
                    </div>
                    <div>
                        {
                            faqs.map(([question, answer]) => (
                                <details class="faq-item">
                                    <>
                                        <summary>{question}</summary>
                                        <div class="faq-answer">{answer}</div>
                                    </>
                                </details>
                            ))
                        }
                    </div>
                </div>
            </section>

            <Location />

            <section
                class="section-pad bg-[color:var(--obsidian)] text-center text-[color:var(--ivory)]"
            >
                <div class="container">
                    <p class="eyebrow text-[color:var(--gold)]">
                        Próximo passo
                    </p>
                    <h2
                        class="serif mx-auto mt-6 max-w-3xl text-6xl leading-[.92] md:text-8xl"
                    >
                        Agende seu atendimento.
                    </h2>
                    <p
                        class="mx-auto mt-8 max-w-lg text-base leading-7 text-[color:var(--muted-dark)]"
                    >
                        Converse pelo WhatsApp oficial e entenda qual caminho
                        faz sentido para seu rosto.
                    </p>
                    <a
                        class="btn btn-gold mt-9"
                        href={whatsappUrl}
                        target="_blank"
                        rel="noreferrer">Chamar no WhatsApp ↗</a
                    >
                </div>
            </section>
        </main>
        <a
            href={whatsappUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="Falar no WhatsApp"
            class="fixed bottom-5 right-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] shadow-lg transition hover:scale-110 focus-visible:outline-white"
            style="animation: rise .6s .5s both"
        >
            <Image
                src={whatsImg}
                alt="Whatsapp"
                class="h-8 w-8 object-contain"
            />

            <span class="sr-only">WhatsApp</span>
        </a>
        <Footer />
    </body>
</html>
